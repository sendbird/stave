{
  "name": "stave",
  "private": true,
  "version": "0.24.3",
  "description": "Stave: AI coding workspace for Claude and Codex.",
  "author": {
    "name": "Sendbird, Inc.",
    "url": "https://sendbird.com/"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/sendbird/stave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendbird/stave.git"
  },
  "bugs": {
    "url": "https://github.com/sendbird/stave/issues"
  },
  "keywords": [
    "ai",
    "agentic-coding",
    "claude",
    "codex",
    "electron",
    "ide"
  ],
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-electron-deps.mjs",
    "server-dev": "bun run server/dev-server.ts",
    "dev": "vite",
    "dev:all": "concurrently -n server,client -c blue,green \"bun run server-dev\" \"bun run dev\"",
    "dev:desktop": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "dev:desktop:poll": "unset ELECTRON_RUN_AS_NODE && CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=120 electron-vite dev",
    "build": "tsc --noEmit && vite build",
    "build:pages": "bun run scripts/build-pages-site.ts",
    "build:desktop": "tsc --noEmit && electron-vite build",
    "package:desktop:dir": "bun run rebuild:electron-deps && bun run build:desktop && electron-builder --config electron-builder.yml --dir",
    "run:desktop:packaged": "bun run rebuild:electron-deps && bun run build:desktop && node scripts/run-desktop-built.mjs",
    "run:desktop:packaged:logged": "bun run rebuild:electron-deps && bun run build:desktop && node scripts/run-desktop-built-logged.mjs",
    "package:desktop": "bun run package:desktop:dir",
    "run:desktop:built": "bun run run:desktop:packaged",
    "desktop:built:logged": "bun run run:desktop:packaged:logged",
    "package:linux:dir": "bun run rebuild:electron-deps && bun run build:desktop && electron-builder --config electron-builder.yml --linux dir",
    "package:linux:appimage": "bun run rebuild:electron-deps && bun run build:desktop && electron-builder --config electron-builder.yml --linux AppImage",
    "package:linux:deb": "bun run rebuild:electron-deps && bun run build:desktop && electron-builder --config electron-builder.yml --linux deb",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:lens-main": "node scripts/typecheck-lens-main.mjs",
    "test": "bun test",
    "test:isolated": "node scripts/run-tests-isolated.mjs",
    "check:doc-paths": "node scripts/check-doc-paths.mjs",
    "check:design-system": "bun scripts/check-design-system-migration.mjs",
    "check:style-channel": "node scripts/check-style-channel.mjs",
    "check:max-lines-ratchet": "node scripts/check-max-lines-ratchet.mjs",
    "check:licenses": "node scripts/check-license-compliance.mjs",
    "check:switch-exhaustiveness": "node scripts/check-switch-exhaustiveness.mjs",
    "check:reliability-gates": "node scripts/check-reliability-gates.mjs",
    "check:temporary-migrations": "node scripts/check-temporary-migrations.mjs",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "qa:ui": "bun run test:e2e",
    "rebuild:electron-deps": "node scripts/rebuild-electron-deps.mjs",
    "test:ci": "bun run check:licenses && bun run check:reliability-gates && bun run check:temporary-migrations && bun run check:style-channel && bun run check:doc-paths && bun run check:max-lines-ratchet && bun run check:switch-exhaustiveness && bun run typecheck && bun run typecheck:lens-main && bun run test:isolated && bun run build && bun run build:desktop"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@anthropic-ai/sdk": "^0.129.0",
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "^4.2.4",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lexical/react": "^0.52.0",
    "@monaco-editor/react": "^4.7.0",
    "@stylexjs/stylex": "0.19.1",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "border-beam": "1.4.1",
    "date-fns": "^4.4.0",
    "dockview-react": "^8.3.1",
    "lexical": "^0.52.0",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "motion": "13.4.5",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "portless": "0.15.6",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.0",
    "react-file-icon": "^1.6.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.15",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "thinking-orbs": "0.3.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.63.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-file-icon": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "license-checker": "25.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "zod": "4.6.5"
  }
}
